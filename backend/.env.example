# Backend environment (copy to .env for local dev)

# HERE Routing & Geocoding API key. Get a free one at https://platform.here.com
# If left EMPTY, the app runs in keyless DEMO MODE (synthetic routes, real weather).
HERE_API_KEY=

# Django
DJANGO_SECRET_KEY=change-me-in-production
DEBUG=True

# Comma-separated. Add your Render host in production, e.g. your-app.onrender.com
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# Comma-separated frontend origins allowed by CORS.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
